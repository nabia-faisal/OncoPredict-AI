# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1

# Model Paths (relative to project root)
MODEL_CLINICAL_PATH=models/random_forest_model.joblib
ENCODER_PATH=models/encoder.joblib
IMPUTER_PATH=models/imputer.joblib
MODEL_IMAGE_PATH=models/image_model.h5

# CORS Configuration (set for production)
# For development: allow all origins
CORS_ORIGINS=["*"]
# For production: restrict to specific domains
# CORS_ORIGINS=["http://localhost:3000", "http://yourdomain.com"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/api.log

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Authentication (simple, for development only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Image Model Configuration
IMAGE_INPUT_SIZE=224
IMAGE_THRESHOLD=0.5

# Feature Configuration
CLINICAL_FEATURES=["age", "menopause", "tumor_size", "inv_nodes", "node_caps", "deg_malig", "breast", "breast_quad", "irradiat"]
NUM_CLINICAL_FEATURES=40

# Confidence Interpretation
RISK_THRESHOLD_HIGH=70
RISK_THRESHOLD_MODERATE=40
RISK_THRESHOLD_LOW=0

# Performance
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
PREDICTION_TIMEOUT=30  # seconds

# Debug Mode (set to False in production)
DEBUG=true
